8,13.1,15.3],"color":"#1baf7a","dashed":false,"carts":[27,45,39,37,20,21,32,23,57,38,49,36,42,56,52,60,62,68,45,45,50,55,19],"visits":[3822,3889,3825,3579,2644,2525,3819,3993,4072,4016,3781,2732,2799,4217,4390,4130,4083,3582,2649,2389,2973,4194,1239],"numword":"visits reached checkout","denword":"organic visits"}],"ck_ymax":25.7,"dark":["2026-08-28","2026-08-29","2026-08-30","2026-08-31","2026-09-01","2026-09-02","2026-09-03","2026-09-04","2026-09-06"],"murky":["2026-08-27","2026-09-05"]},"attribution_html":"\n<section>\n  <h2>Where orders come from</h2>\n  <div class=\"sub\">Google Analytics, today so far &middot; treat as directional, not exact</div>\n  <div class=\"bots\">\n    <b>Bot traffic has been removed from every number in this section.</b> Datacenter\n    crawlers from Google Cloud and AWS hit this site hard, loading a page for two seconds\n    and leaving. On 2026-09-09 that was\n    <b>4,275 of 6,650</b> US sessions.\n    Visit counts below are <b>engaged sessions</b>, meaning a real person read the page.\n    Google Analytics' own dashboard does <b>not</b> filter this, so its traffic numbers will\n    look several times larger than these and its conversion rates several times worse.\n  </div>\n  <div class=\"warn\">\n    <b>Read this before quoting anything below.</b> These figures come from\n    Google Analytics and are much less reliable than the revenue above. Analytics data runs through <b>11:53 AM PT</b>, about <b>2h 1m</b> behind this page.\n    Analytics is also not recording checkout correctly yet: it logged\n    <b>3 payment steps</b> today against\n    <b>4 real paid orders</b>, and our purchase event sends no order value,\n    so Analytics reports <b>$0 revenue</b> no matter what sells. Use it to see which\n    pages bring people in, never to count orders or money.\n  </div>\n  <h3 class=\"mini\">Traffic and carts by page type</h3>\n  <table class=\"attr\"><thead><tr><th>Page type</th><th>Engaged visits</th><th>Carts</th><th>Cart rate</th></tr></thead>\n  <tbody><tr class=\"hot\"><td>/tests/</td><td class=\"amt\">872</td><td class=\"amt\">16</td><td class=\"amt\">1.83%</td></tr><tr class=\"hot\"><td>Homepage</td><td class=\"amt\">548</td><td class=\"amt\">13</td><td class=\"amt\">2.37%</td></tr><tr><td>/treatments/</td><td class=\"amt\">362</td><td class=\"amt\">0</td><td class=\"amt\">0.00%</td></tr><tr class=\"hot\"><td>Everything else</td><td class=\"amt\">204</td><td class=\"amt\">5</td><td class=\"amt\">2.45%</td></tr><tr class=\"hot\"><td>/std-testing/</td><td class=\"amt\">198</td><td class=\"amt\">29</td><td class=\"amt\">14.65%</td></tr><tr><td>/articles/</td><td class=\"amt\">155</td><td class=\"amt\">0</td><td class=\"amt\">0.00%</td></tr><tr><td>/blood-testing/</td><td class=\"amt\">22</td><td class=\"amt\">0</td><td class=\"amt\">0.00%</td></tr><tr class=\"hot\"><td>/std-test-pricing</td><td class=\"amt\">7</td><td class=\"amt\">4</td><td class=\"amt\">57.14%</td></tr><tr><td>/find-a-lab</td><td class=\"amt\">3</td><td class=\"amt\">0</td><td class=\"amt\">0.00%</td></tr></tbody></table>\n  <h3 class=\"mini\">By how people arrived</h3>\n  <table class=\"attr\"><thead><tr><th>Source</th><th>Engaged visits</th><th>Carts</th><th>Cart rate</th></tr></thead>\n  <tbody><tr><td>Organic Search</td><td class=\"amt\">1,239</td><td class=\"amt\">35</td><td class=\"amt\">2.82%</td></tr><tr><td>Direct</td><td class=\"amt\">867</td><td class=\"amt\">17</td><td class=\"amt\">1.96%</td></tr><tr><td>Cross-network</td><td class=\"amt\">235</td><td class=\"amt\">8</td><td class=\"amt\">3.40%</td></tr><tr><td>Referral</td><td class=\"amt\">33</td><td class=\"amt\">0</td><td class=\"amt\">0.00%</td></tr><tr><td>Organic Social</td><td class=\"amt\">3</td><td class=\"amt\">0</td><td class=\"amt\">0.00%</td></tr></tbody></table>\n  <h3 class=\"mini\">By device</h3>\n  <table class=\"attr\"><thead><tr><th>Device</th><th>Engaged visits</th><th>Carts</th><th>Cart rate</th></tr></thead>\n  <tbody><tr><td>Mobile</td><td class=\"amt\">1,710</td><td class=\"amt\">54</td><td class=\"amt\">3.16%</td></tr><tr><td>Desktop</td><td class=\"amt\">629</td><td class=\"amt\">13</td><td class=\"amt\">2.07%</td></tr><tr><td>Tablet</td><td class=\"amt\">38</td><td class=\"amt\">0</td><td class=\"amt\">0.00%</td></tr></tbody></table>\n  <h3 class=\"mini\">Which page the cart button is actually pressed on</h3><table class=\"attr2\"><thead><tr><th>Page</th><th>Carts</th></tr></thead><tbody><tr><td>/std-test-pricing/</td><td class=\"amt\">33</td></tr><tr><td>/tests/complete-blood-count-cbc/</td><td class=\"amt\">12</td></tr><tr><td>/tests/fasting-insulin-test/</td><td class=\"amt\">4</td></tr><tr><td>/tests/vitamin-a/</td><td class=\"amt\">3</td></tr><tr><td>/</td><td class=\"amt\">2</td></tr><tr><td>/checkout/o8hz85/</td><td class=\"amt\">1</td></tr><tr><td>/std-testing/full-std-panel/</td><td class=\"amt\">1</td></tr><tr><td>/std-testing/hsv-1-test/</td><td class=\"amt\">1</td></tr></tbody></table>\n  <p class=\"note\"><b>Visits above are engaged sessions</b>, meaning someone actually read\n  the page. Today 4,275 of 6,650 US\n  sessions were non-engaged, almost all of it datacenter crawler traffic from Google Cloud\n  and AWS that loads a page for two seconds and leaves. Counting those would roughly\n  quadruple the denominator and make every rate here look four times worse than reality.</p>\n</section>","notice_html":"<div class=\"notice\"><b>The site stopped recording its checkout events part way through Aug 27, so every cart and checkout figure below is wrong from that day on.</b> Since Aug 28 purchase, email capture and payment events have logged nothing at all, and cart counts collapsed with them, while Stripe went on taking orders: 91 paid orders landed across those days. Aug 27 itself is drawn, but it is an undercount rather than a fall. Orders, revenue and traffic come from Stripe and from page views, so those are unaffected and can be read normally. Days with no tracking are drawn as gaps, never as zeros. Tracked on GitLab work item 358.</div>","daily":[{"date":"2026-08-10","partial":false,"organic_visits":3318,"engaged_sessions":5620,"checkout_visits":0,"org_checkout_visits":0,"carts":0,"reached_checkout":0},{"date":"2026-08-11","partial":false,"organic_visits":3408,"engaged_sessions":5815,"checkout_visits":0,"org_checkout_visits":0,"carts":0,"reached_checkout":0},{"date":"2026-08-12","partial":false,"organic_visits":3280,"engaged_sessions":5610,"checkout_visits":0,"org_checkout_visits":0,"carts":0,"reached_checkout":0},{"date":"2026-08-13","partial":false,"organic_visits":3174,"engaged_sessions":5516,"checkout_visits":0,"org_checkout_visits":0,"carts":0,"reached_checkout":0},{"date":"2026-08-14","partial":false,"organic_visits":2998,"engaged_sessions":5023,"checkout_visits":0,"org_checkout_visits":0,"carts":0,"reached_checkout":0},{"date":"2026-08-15","partial":false,"organic_visits":2270,"engaged_sessions":3589,"checkout_visits":0,"org_checkout_visits":0,"carts":0,"reached_checkout":0},{"date":"2026-08-16","partial":false,"organic_visits":2222,"engaged_sessions":3489,"checkout_visits":0,"org_checkout_visits":0,"carts":0,"reached_checkout":0},{"date":"2026-08-17","partial":false,"organic_visits":3414,"engaged_sessions":5654,"checkout_visits":0,"org_checkout_visits":0,"carts":0,"reached_checkout":0},{"date":"2026-08-18","partial":false,"organic_visits":3822,"engaged_sessions":6847,"checkout_visits":46,"org_checkout_visits":27,"carts":93,"reached_checkout":52},{"date":"2026-08-19","partial":false,"organic_visits":3889,"engaged_sessions":6535,"checkout_visits":57,"org_checkout_visits":45,"carts":88,"reached_checkout":53},{"date":"2026-08-20","partial":false,"organic_visits":3825,"engaged_sessions":6346,"checkout_visits":47,"org_checkout_visits":39,"carts":79,"reached_checkout":61},{"date":"2026-08-21","partial":false,"organic_visits":3579,"engaged_sessions":5863,"checkout_visits":43,"org_checkout_visits":37,"carts":78,"reached_checkout":44},{"date